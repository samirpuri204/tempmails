# Public site. Use http://localhost:3000 locally.
APP_URL=https://tempmails.live
NEXT_PUBLIC_APP_URL=https://tempmails.live
DATABASE_URL=postgresql://tempmails:CHANGE_ME@localhost:5432/tempmails
REDIS_URL=redis://localhost:6379
# Generate each independently with: openssl rand -hex 32
APP_SECRET=
INBOUND_SECRET=
CRON_SECRET=
# Seed domain is disabled until DNS has been configured.
EMAIL_DOMAIN=tempmails.live
# Used only by npm run owner:create; remove afterward.
OWNER_EMAIL=
OWNER_PASSWORD=
# Required in production. Register hostname in Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Trusted reverse proxy must overwrite x-real-ip; Vercel does this.
TRUST_PROXY=false
# Optional HTTPS scanner. Receives raw bytes, returns {"clean":true}; fail closed.
MALWARE_SCAN_URL=
MALWARE_SCAN_SECRET=
# Optional Resend admin alerts. The same key also delivers visitor-sent
# (outbound) mail when anonymous sending is enabled in /admin. Verify the
# temporary domain in Resend (SPF + DKIM) before enabling.
RESEND_API_KEY=
ALERT_FROM=
ALERT_TO=
# Sender for the public contact form's notification. Must be an address the
# provider has verified for the site's own domain (SPF + DKIM), otherwise the
# notification is refused. Falls back to ALERT_FROM, then to
# contact@$EMAIL_DOMAIN, and the form reports itself unavailable when neither
# the provider nor this sender is configured. The destination is the
# contactEmail setting, not an environment variable.
CONTACT_FROM=
# Alternative outbound transport when RESEND_API_KEY is not set, e.g.
# smtps://user:pass@smtp.example.com:465 — must be allowed to send for the
# temporary domain(s). Leave empty to allow only temp-to-temp delivery.
SMTP_URL=
# Optional error sink: only redacted error codes and timestamps are sent.
ERROR_MONITOR_URL=
# ---------------------------------------------------------------------------
# Adverts (Monetag, with Google AdSense as the alternative). Every value here is
# public — it ends up in the client bundle. Placement map and reasoning:
# docs/MONETIZATION.md. Parsing and defaults: lib/ad-config.ts. These are
# inlined at build time, so change them in the host environment and redeploy;
# editing them at runtime does nothing.
# ---------------------------------------------------------------------------
# Master switch. `false` removes every ad script, every ad unit and every
# reserved ad space from the site.
NEXT_PUBLIC_ADS_ENABLED=true
# monetag | adsense | both | none. Monetag is the default. Monetag is tag-based
# and places its own formats site-wide; AdSense is the only network that can
# occupy a named in-content position, using the slot ids set in /admin. With
# `both`, the two never share a position. An unrecognised value (a leftover from
# a network that has been removed) falls back to the default rather than
# silently turning ads off.
NEXT_PUBLIC_ADS_PROVIDER=monetag
# --- Monetag — PASTE YOUR ZONE HERE ----------------------------------------
# The Multitag zone id. Which formats run (vignette, in-page push, interstitial,
# onclick) and how often is a Monetag dashboard setting for this zone.
NEXT_PUBLIC_MONETAG_ZONE=282200
# The tag URL. Only change this if Monetag issues a different one.
NEXT_PUBLIC_MONETAG_SRC=https://quge5.com/88/tag.min.js
# ON. Inserted once per page from the root layout, never on /admin, and never
# when the visitor has Data Saver on.
NEXT_PUBLIC_MONETAG_ENABLED=true
# Delay after hydration before the tag is inserted, so the overlay cannot
# compete with the first paint of the inbox. 0 loads it immediately.
NEXT_PUBLIC_MONETAG_DELAY_MS=900
# How long the tag is given to load before its outcome is read. A blocked tag
# fails *after* insertion, so this window is what makes "blocked" distinguishable
# from "loaded" in the report below.
NEXT_PUBLIC_ADS_FILL_WINDOW_MS=4000
# Each page view reports whether the ad tag reached the document — filled,
# blocked or empty — so a session with no ad can be diagnosed from /admin →
# Overview without devtools or a second guess. Aggregate counters only: a
# country, an outcome and a count, never a visitor. Set false to send none.
NEXT_PUBLIC_ADS_FILL_REPORT=true
# --- Adsterra — PASTE YOUR UNIT CODES HERE ----------------------------------
# Two units from the same Adsterra account. Neither is gated by
# NEXT_PUBLIC_ADS_PROVIDER: Adsterra is a banner network, and it occupies
# positions the other two do not claim, so it runs alongside them. The only
# switch that turns it off is NEXT_PUBLIC_ADS_ENABLED above.
#
# Unit 31284975, Banner 468x60. Key and loader host come straight from the
# unit's snippet, which is an atOptions block followed by an invoke loader:
#   atOptions = { 'key': '<KEY>', 'format': 'iframe', 'height': 60, 'width': 468 }
#   <script src="<HOST>/<KEY>/invoke.js"></script>
# The host is NOT adsterra.com — Adsterra serves zones from unrelated-looking
# domains. Leaving either value unset renders nothing rather than shipping an
# unkeyed or hostless banner.
NEXT_PUBLIC_ADSTERRA_KEY=667e12baeee8c82d264233fab2ccfd93
NEXT_PUBLIC_ADSTERRA_HOST=https://doubtfulimpatient.com
#
# Unit 31284981, Social Bar — the notification-style unit, and the second unit
# mounted site-wide (at the end of the document, which is the placement its
# publisher code specifies). This unit's entire snippet is ONE script tag, so
# the URL is stored verbatim rather than rebuilt from a host and key: the shard
# layout is Adsterra's own scheme and is not ours to reconstruct. It is served
# from the same host as the banner above, so it adds no new preconnect origin.
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_SRC=https://doubtfulimpatient.com/cb/da/4c/cbda4cbf2b82f3025938bd54a7789f12.js
